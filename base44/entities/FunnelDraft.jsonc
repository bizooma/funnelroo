{
  "name": "FunnelDraft",
  "type": "object",
  "properties": {
    "funnel_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "page_blocks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "primary_color": {
          "type": "string"
        },
        "accent_color": {
          "type": "string"
        },
        "font": {
          "type": "string"
        }
      }
    },
    "form_config": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "submit_label": {
          "type": "string"
        }
      }
    },
    "resource_version_id": {
      "type": "string"
    },
    "delivery_mode": {
      "type": "string",
      "enum": [
        "immediate_only",
        "immediate_plus_email"
      ],
      "default": "immediate_only"
    },
    "sender_id": {
      "type": "string"
    },
    "consent_text": {
      "type": "string"
    },
    "form_version": {
      "type": "string"
    },
    "resource_id": {
      "type": "string"
    },
    "sequence_ref": {
      "type": "string"
    },
    "booking_config": {
      "type": "object",
      "properties": {
        "calendly_url": {
          "type": "string"
        },
        "event_type": {
          "type": "string"
        }
      }
    },
    "booking_event_type_id": {
      "type": "string"
    },
    "booking_cta_label": {
      "type": "string"
    },
    "booking_cta_copy": {
      "type": "string"
    },
    "publishing_checks": {
      "type": "object",
      "properties": {
        "has_resource": {
          "type": "boolean"
        },
        "has_form": {
          "type": "boolean"
        },
        "has_sender": {
          "type": "boolean"
        },
        "has_sequence": {
          "type": "boolean"
        },
        "has_booking": {
          "type": "boolean"
        }
      }
    },
    "wizard_progress": {
      "type": "object",
      "properties": {
        "step": {
          "type": "number"
        },
        "completed_steps": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      }
    },
    "context_snapshot": {
      "type": "object",
      "properties": {
        "audience_id": {
          "type": "string"
        },
        "audience_revision": {
          "type": "string"
        },
        "offer_id": {
          "type": "string"
        },
        "offer_revision": {
          "type": "string"
        },
        "business_profile_id": {
          "type": "string"
        },
        "resource_version_id": {
          "type": "string"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "setup_step": {
      "type": "string"
    }
  },
  "required": [
    "funnel_id",
    "workspace_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}