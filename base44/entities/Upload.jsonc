{
  "name": "Upload",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "file_uri": {
      "type": "string"
    },
    "filename": {
      "type": "string"
    },
    "content_type": {
      "type": "string"
    },
    "size_bytes": {
      "type": "number"
    },
    "created_by": {
      "type": "string"
    },
    "consumed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "workspace_id",
    "file_uri"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}