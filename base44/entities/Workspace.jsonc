{
  "name": "Workspace",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "time_zone": {
      "type": "string",
      "default": "America/Chicago"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "suspended"
      ],
      "default": "active"
    },
    "plan": {
      "type": "string",
      "enum": [
        "trial",
        "starter",
        "growth",
        "agency"
      ],
      "default": "trial"
    },
    "mascot_image_url": {
      "type": "string"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "slug",
    "owner_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}