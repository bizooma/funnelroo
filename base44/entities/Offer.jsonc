{
  "name": "Offer",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "offer": {
      "type": "string"
    },
    "goal": {
      "type": "string",
      "enum": [
        "lead_magnet",
        "direct_booking",
        "service_inquiry"
      ]
    },
    "cta": {
      "type": "string"
    },
    "supporting_proof": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approved": {
      "type": "boolean",
      "default": false
    },
    "ai_suggested": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "workspace_id",
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}