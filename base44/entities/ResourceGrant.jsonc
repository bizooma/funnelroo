{
  "name": "ResourceGrant",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "submission_id": {
      "type": "string"
    },
    "resource_version_id": {
      "type": "string"
    },
    "resource_id": {
      "type": "string"
    },
    "access_token": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked": {
      "type": "boolean",
      "default": false
    },
    "accessed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "workspace_id",
    "submission_id",
    "resource_version_id",
    "access_token"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}