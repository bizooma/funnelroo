{
  "name": "FunnelLead",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "funnel_id": {
      "type": "string"
    },
    "contact_id": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "first_submission_id": {
      "type": "string"
    },
    "latest_submission_id": {
      "type": "string"
    },
    "acquisition_source": {
      "type": "string"
    },
    "acquisition_campaign": {
      "type": "string"
    },
    "first_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "sales_stage": {
      "type": "string",
      "enum": [
        "new",
        "nurturing",
        "booked",
        "won",
        "lost"
      ],
      "default": "new"
    },
    "stage_changed_by": {
      "type": "string"
    },
    "stage_changed_at": {
      "type": "string",
      "format": "date-time"
    },
    "stage_change_reason": {
      "type": "string"
    },
    "origin": {
      "type": "string",
      "enum": [
        "capture",
        "booking"
      ],
      "default": "capture"
    }
  },
  "required": [
    "workspace_id",
    "funnel_id",
    "contact_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}