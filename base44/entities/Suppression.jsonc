{
  "name": "Suppression",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "contact_id": {
      "type": "string"
    },
    "email_normalized": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "unsubscribe",
        "bounce",
        "complaint",
        "sender_restriction"
      ]
    },
    "source": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "email_normalized",
    "reason"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}