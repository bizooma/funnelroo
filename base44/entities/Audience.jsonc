{
  "name": "Audience",
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "roles_industries": {
      "type": "string"
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "desired_outcomes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "objections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approved": {
      "type": "boolean",
      "default": false
    },
    "ai_suggested": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "archived"
      ],
      "default": "draft"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_id": {
      "type": "string"
    },
    "persona": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "industry": {
          "type": "string"
        },
        "company_size": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "buying_role": {
          "type": "string"
        },
        "age": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "portrait_url": {
          "type": "string"
        },
        "portrait_credit": {
          "type": "string"
        },
        "quote_text": {
          "type": "string"
        },
        "quote_source": {
          "type": "string"
        },
        "quote_kind": {
          "type": "string",
          "enum": [
            "customer",
            "representative",
            "illustrative"
          ]
        },
        "bio_summary": {
          "type": "string"
        },
        "motivations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "explanation": {
                "type": "string"
              },
              "rating": {
                "type": "number"
              }
            }
          }
        },
        "buying_style": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pair_label": {
                "type": "string"
              },
              "left": {
                "type": "string"
              },
              "right": {
                "type": "string"
              },
              "position": {
                "type": "number"
              }
            }
          }
        },
        "messaging_guidance": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "heading": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "messaging_ai_suggested": {
          "type": "boolean",
          "default": false
        },
        "theme": {
          "type": "object",
          "properties": {
            "accent": {
              "type": "string"
            },
            "preset": {
              "type": "string"
            }
          }
        },
        "highlights_only": {
          "type": "boolean",
          "default": false
        },
        "content_hash": {
          "type": "string"
        },
        "source_revision": {
          "type": "string"
        },
        "stale": {
          "type": "boolean",
          "default": false
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_by": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "workspace_id",
    "name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}