{
  "name": "PublishedFunnelVersion",
  "type": "object",
  "properties": {
    "funnel_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "version_number": {
      "type": "number"
    },
    "snapshot": {
      "type": "object"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_by": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "funnel_id",
    "workspace_id",
    "version_number"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}